# Supabase Session Pooler connection string (IPv4). The direct connection is
# IPv6-only and Render cannot reach it.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Origin allowed by CORS. Defaults to http://localhost:5173 when unset.
CLIENT_ORIGIN=
# Metered sources. Live discovery degrades gracefully without these — the
# seven keyless sources still answer.
TAVILY_API_KEY=
YOUTUBE_API_KEY=
