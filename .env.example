# Supabase Session Pooler connection string (IPv4). The direct connection is
# IPv6-only and Render cannot reach it.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Origin allowed by CORS. Defaults to http://localhost:5173 when unset.
CLIENT_ORIGIN=
# Metered sources. Live discovery degrades gracefully without these — the
# seven keyless sources still answer.
TAVILY_API_KEY=
YOUTUBE_API_KEY=
# Optional Spotify-first podcast search. Without both credentials, or when the
# development quota is exhausted, the keyless Apple catalog remains the fallback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

# Shared AI library. Keep false until the worker has keys, the migration is
# applied, and the first selections have been reviewed. Never use VITE_ here.
AI_ENABLED=false
# Worker only; the Express API does not need these keys.
GEMINI_API_KEY=
AI_LITE_MODEL=gemini-3.5-flash-lite
AI_CURATOR_MODEL=gemini-3.8-flash
# Optional server-side embeddings. Missing keys use lexical retrieval instead.
CF_ACCOUNT_ID=
CF_AI_API_TOKEN=
# Lower these to match the quotas actually shown in your provider dashboard.
AI_LITE_REQUESTS_DAY=18
AI_CURATOR_REQUESTS_DAY=8
AI_TAVILY_CREDITS_DAY=30
AI_TAVILY_CREDITS_MONTH=800
AI_USER_NEW_REQUESTS_MONTH=2
AI_QUEUE_LIMIT=100
AI_CATALOGUE_LIMIT=5000
